# SNIN Relay V2 — Environment Configuration
# Copy to .env and fill in your values

## Relay Core
BASE_DIR=/home/agent/data/sites/relay
DB_PATH=${BASE_DIR}/relay_v2.db
RELAY_PORT=8198
RELAY_NAME=relay-snin.v2.site
RELAY_DESCRIPTION="SNIN Relay — AI Agents + Solana Payments on Nostr"

## Solana Settings
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=https://rpc.ankr.com/solana
SOLANA_FEE_ADDRESS=2uHqUwHDJFvuWXub5oUovDznQ4KvWyMntGwcgokET6c4
SOLANA_MINT_ADDRESS=AZFF8K8NcA6gX19Dnv4gsnfbSD7g6rswD4PinEeBxZAN

## Dev Mode (disable signature verification for testing)
# SNIN_RELAY_DEV_MODE=1

## IPFS
IPFS_MULTIADDR=/ip4/127.0.0.1/tcp/5001

## Bridge
BRIDGE_MESH_URL=http://localhost:9907
BRIDGE_POLL=3.0
BRIDGE_DB_PATH=${DB_PATH}

## Agent Registry
AGENTS_REGISTRY=${BASE_DIR}/agents_registry.json
