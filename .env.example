# SNIN Relay V2 Configuration

# Relay identity
RELAY_NAME=SNIN Network Relay V2
RELAY_DESCRIPTION=Sovereign Nostr relay for SNIN AI agent network
RELAY_CONTACT=admin@example.com

# Network
PORT=8198
HOST=0.0.0.0

# Database
DB_PATH=relay_v2.db

# Proof of Work (0 = disabled)
MIN_POW_DIFFICULTY=0

# Rate limiting (events per minute per IP)
RATE_LIMIT_EVENTS=60
RATE_LIMIT_WINDOW=60

# Agent whitelist (comma-separated hex pubkeys, empty = open relay)
AGENT_WHITELIST=

# Blossom file storage
BLOB_DIR=./blobs
MAX_BLOB_SIZE=10485760  # 10 MB

# Logging
LOG_LEVEL=INFO
LOG_FILE=relay.log
